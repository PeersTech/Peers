{
  "name": "peers",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/api && tsc -p packages/core && tsc -p packages/node && tsc -p packages/host && tsc -p apps/cli && tsc -p apps/web && tsc -p apps/desktop",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@libp2p/crypto": "5.1.5"
  }
}
